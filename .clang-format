BasedOnStyle: LLVM

# Indentation
IndentWidth: 4
UseTab: Never

# Braces
BreakBeforeBraces: Custom
BraceWrapping:
  AfterFunction: true
  AfterControlStatement: Never

# Treat C-style brace initializers as blocks rather than function-call arguments
Cpp11BracedListStyle: false

# Pointers
PointerAlignment: Right

# Line Length
ColumnLimit: 0

# Short Functions
AllowShortFunctionsOnASingleLine: None